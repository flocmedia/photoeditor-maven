<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.github.javiersantos</groupId>
  <artifactId>MaterialStyledDialogs</artifactId>
  <version>2.1</version>
  <packaging>aar</packaging>
  <name>javiersantos/MaterialStyledDialogs</name>
  <description>A library that shows a beautiful and customizable Material-based dialog with header. API 14+ required.</description>
  <url>https://github.com/javiersantos/MaterialStyledDialogs</url>
  <inceptionYear>2016</inceptionYear>
  <licenses>
    <license>
      <name>Apache License 2.0</name>
      <url>https://api.github.com/licenses/apache-2.0</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>javiersantos</id>
      <name>Javier Santos</name>
      <email>me@javiersantos.me</email>
    </developer>
  </developers>
  <scm>
    <connection>scm:git://github.com/javiersantos/MaterialStyledDialogs.git</connection>
    <developerConnection>scm:git://github.com/javiersantos/MaterialStyledDialogs.git</developerConnection>
    <url>git://github.com/javiersantos/MaterialStyledDialogs.git</url>
  </scm>
  <dependencies>
    <dependency>
      <groupId>com.android.support</groupId>
      <artifactId>appcompat-v7</artifactId>
      <version>25.1.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.afollestad.material-dialogs</groupId>
      <artifactId>core</artifactId>
      <version>0.9.0.2</version>
      <scope>compile</scope>
    </dependency>
  </dependencies>
</project>
